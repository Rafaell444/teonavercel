# Copy to .env.local for local development. On Vercel, add these in
# Project → Settings → Environment Variables.

# ── Firebase (required) ────────────────────────────────────────────────────
# Firebase console → Project settings → Service accounts → "Generate new private key".
# Paste the whole JSON on one line (or base64-encode it).
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-...@....iam.gserviceaccount.com", ...}

# Firebase console → Project settings → General → "Web API Key".
# Used to sign members in with email + password.
FIREBASE_WEB_API_KEY=AIza...

# Only Authentication and Firestore are used (both free). Uploaded files are
# stored in Firestore, so Firebase Storage does not need to be enabled.

# ── Payments ───────────────────────────────────────────────────────────────
# Off by default: bookings are requests the coach confirms in the admin panel
# and payment is arranged directly. Set to true to show "Confirm & Pay",
# the voucher step and to confirm group seats immediately.
NEXT_PUBLIC_PAYMENTS_ENABLED=false

# ── Notifications (optional) ───────────────────────────────────────────────
# Without RESEND_API_KEY, emails are only logged (Firestore → notificationLogs).
# RESEND_API_KEY=re_...
# EMAIL_FROM=TEONA <hello@yourdomain.com>
# ADMIN_EMAIL=you@yourdomain.com
# ADMIN_PHONE=+995...

# ── Seeding (used only by `pnpm seed`) ─────────────────────────────────────
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=change-me-now
# Demo member for trying the booking flow. Set SEED_MEMBER_PASSWORD= (empty)
# to skip creating it, e.g. on the production project.
# SEED_MEMBER_EMAIL=elena@email.com
# SEED_MEMBER_PASSWORD=member1234
