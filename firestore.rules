rules_version = '2';

// All reads and writes go through the Next.js API, which uses the Admin SDK
// and is not subject to these rules. Browsers never talk to Firestore
// directly, so client access is denied completely.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
